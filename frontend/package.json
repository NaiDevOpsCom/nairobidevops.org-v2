    "embla-carousel-react": "^8.6.0",
    "ical.js": "^2.2.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-countup": "^6.5.3",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.91.0",
    "react-intersection-observer": "^11.0.1",
    "react-player": "^3.4.0",
    "react-resizable-panels": "^4.20.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
